{
  "name": "candy-land",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "images:webp": "node scripts/convert-webp.js",
    "assert:public-routes": "node scripts/assert-public-routes.mjs",
    "assert:home-redesign": "node scripts/assert-home-redesign.mjs",
    "assert:admin-auth-products": "node scripts/assert-admin-auth-products.mjs",
    "test:home-redesign": "node --test test/home-redesign.test.mjs",
    "test:admin-auth-products": "node --test test/admin-auth-products.test.mjs",
    "test:admin-product-form": "node --test test/admin-product-form.test.mjs",
    "assert:admin-product-form": "node scripts/assert-admin-auth-products.mjs",
    "test:admin-categories": "node --test test/admin-categories.test.mjs",
    "assert:admin-categories": "node scripts/assert-admin-auth-products.mjs",
    "test:admin-orders": "node --test test/admin-orders.test.mjs",
    "assert:admin-orders": "node scripts/assert-admin-auth-products.mjs",
    "assert:admin-runtime-receipt": "node scripts/assert-runtime-admin-orders-receipt.mjs",
    "test:admin-runtime": "node --check test/admin-auth-products.playwright.mjs && echo 'Run this file with the configured Playwright MCP runtime'",
    "test:checkout-hardening": "node --test test/checkout-hardening.test.mjs",
    "test:checkout-differential": "node --test test/checkout-hardening-differential.test.mjs",
    "assert:checkout-hardening": "node scripts/assert-checkout-hardening.mjs",
    "test:checkout-runtime": "node --check test/checkout-hardening.playwright.mjs && echo 'Run this file with the configured Playwright MCP runtime'",
    "test:production-deploy-qa": "node --test backend/test/env-check-removed.test.js test/production-deploy-qa.test.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:demo-mock": "node --test test/demo-mock.test.mjs",
    "test": "node --test test/home-redesign.test.mjs test/admin-auth-products.test.mjs test/admin-product-form.test.mjs test/admin-categories.test.mjs test/admin-orders.test.mjs test/admin-runtime-batches.test.mjs test/checkout-hardening.test.mjs test/checkout-hardening-differential.test.mjs test/demo-mock.test.mjs backend/test/env-check-removed.test.js test/production-deploy-qa.test.mjs",
    "postinstall": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:seed": "node backend/prisma/seed.js",
    "db:reset": "prisma migrate reset --schema backend/prisma/schema.prisma --force"
  },
  "prisma": {
    "seed": "node backend/prisma/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "@prisma/client": "^5.22.0",
    "serverless-http": "^3.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2",
    "prisma": "^5.22.0",
    "sharp": "^0.33.5"
  }
}
