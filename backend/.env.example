# CandyLand Backend — variables de entorno (placeholders, NO valores reales)
# Copiá este archivo a .env y completá con tus valores. Nunca commitees .env.

# Runtime
NODE_ENV=development
PORT=5050
HOST=0.0.0.0

# PostgreSQL (Railway en producción; PostgreSQL local en desarrollo)
# Ejemplo: postgresql://usuario:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://usuario:password@localhost:5432/candyland

# CORS (lista de orígenes separados por coma; se cablea en la fase Railway/Vercel)
CORS_ORIGIN=http://localhost:5173,https://candy-land-mvp.vercel.app

# JWT / admin
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@candyland.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Datos bancarios (mostrar si se elige transferencia)
BANK_ALIAS=replace-with-bank-alias
BANK_CBU=replace-with-bank-cbu
BANK_TITULAR=replace-with-bank-owner

# Email (proveedor desacoplado; noop funciona sin credenciales)
# EMAIL_PROVIDER=noop  -> deshabilitado, sólo loguea (default local/dev)
# EMAIL_PROVIDER=resend -> usa Resend via Node 20 fetch (requiere RESEND_API_KEY/MAIL_FROM/MAIL_TO)
EMAIL_PROVIDER=noop
RESEND_API_KEY=
MAIL_FROM=CandyLand <replace-with-sender@example.com>
MAIL_TO=replace-with-recipient@example.com
